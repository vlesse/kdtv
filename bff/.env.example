# Upstream XUI.one panel, as reachable from THIS service.
XUI_BASE=http://localhost:9080
# Address the set-top box uses to pull video. Point this at your domain.
XUI_PUBLIC_BASE=http://localhost:9080
# House line handed to a box that has not been bound to a room yet.
DEFAULT_LINE_USER=1000
DEFAULT_LINE_PASS=666666
PORT=9081
APP_VERSION=1.0.0
